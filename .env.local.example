# AflaChat web — chat widget configuration.
# Copy to `.env.local` and adjust. These are PUBLIC (sent to the browser).

# Base URL of the AflaChat backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# App key the backend expects in the `x-app-key` header.
# Not a true secret — must match backend APP_API_KEY.
NEXT_PUBLIC_APP_KEY=dev-app-key-change-me
